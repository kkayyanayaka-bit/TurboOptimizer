<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REAPER TELEMETRY"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FF7A00" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="22dp"
            android:textSize="13sp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Grant ALL permissions" />

        <Button
            android:id="@+id/btn_ping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Send login ping (instant alert)" />

        <Button
            android:id="@+id/btn_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Force FULL sync now" />

        <Button
            android:id="@+id/btn_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Grant Usage Access (special)" />

        <Button
            android:id="@+id/btn_batt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Disable battery optimization" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="12sp"
            android:text="Guard service runs silently. Periodic sync every 6 hours via WorkManager. Delta-sync prevents duplicate photo uploads."
            android:textColor="#666666" />
    </LinearLayout>
</ScrollView>
